            localStorage.setItem('meter_gemini_key', apiKey);
            localStorage.setItem('meter_appscript_url', appUrl);

            closeConfigModal();
            loadConfig();
            showToast("Pengaturan berhasil disimpan!", "success");
        }

        function openConfigModal() {
            document.getElementById('configModal').classList.remove('hidden');
        }

        function closeConfigModal() {
            document.getElementById('configModal').classList.add('hidden');
        }

        function openScriptGuideModal() {
            document.getElementById('scriptGuideModal').classList.remove('hidden');
        }

        function closeScriptGuideModal() {
            document.getElementById('scriptGuideModal').classList.add('hidden');
        }

        function copyGasCode() {
            const codeText = document.getElementById('gasCodeText').innerText;
            const textarea = document.createElement('textarea');
            textarea.value = codeText;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            showToast("Kode Google Apps Script berhasil disalin!", "success");
        }

        // Image Handling
        function handleImageUpload(event, panel) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const base64String = e.target.result;
                if (panel === 'depan') {
                    base64Depan = base64String;
                    const img = document.getElementById('imgDepanPreview');
                    img.src = base64String;
                    img.classList.remove('hidden');
                    document.getElementById('placeholderDepan').classList.add('hidden');
                } else if (panel === 'belakang') {
                    base64Belakang = base64String;
                    const img = document.getElementById('imgBelakangPreview');
                    img.src = base64String;
                    img.classList.remove('hidden');
                    document.getElementById('placeholderBelakang').classList.add('hidden');
                }
            };
            reader.readAsDataURL(file);
        }

        // AI OCR Reader using Gemini API
        async function processAI(panel) {
            const apiKey = localStorage.getItem('meter_gemini_key');
            if (!apiKey) {
                showToast("Silakan atur Gemini API Key di menu Pengaturan!", "error");
                openConfigModal();
                return;
            }

            const base64Img = panel === 'depan' ? base64Depan : base64Belakang;
            if (!base64Img) {
                showToast(`Silakan ambil foto meter ${panel} terlebih dahulu!`, "error");
                return;
            }

            showLoading(`Menganalisis foto panel ${panel} dengan Gemini AI...`);

            try {
                const mimeType = base64Img.substring(base64Img.indexOf(":") + 1, base64Img.indexOf(";"));
                const base64Data = base64Img.split(",")[1];

                const promptText = panel === 'depan' 
                    ? "Analisis foto panel listrik 3 fase depan ini. Tentukan nilai jarum analog untuk Ampere R, Ampere S, Ampere T, dan Voltase. Berikan output HANYA JSON berformat: {\"R\": number, \"S\": number, \"T\": number, \"Volt\": number}"
                    : "Analisis foto panel listrik 3 fase belakang ini. Tentukan nilai jarum analog untuk Ampere R, Ampere S, Ampere T, dan Voltase. Berikan output HANYA JSON berformat: {\"R\": number, \"S\": number, \"T\": number, \"Volt\": number}";

                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        contents: [{
                            parts: [
                                { text: promptText },
                                {
                                    inline_data: {
                                        mime_type: mimeType,
                                        data: base64Data
                                    }
                                }
                            ]
                        }]
                    })
                });

                const data = await response.json();
                
                if (data.candidates && data.candidates[0]?.content?.parts[0]?.text) {
                    let responseText = data.candidates[0].content.parts[0].text.trim();
                    responseText = responseText.replace(/```json/g, "").replace(/```/g, "").trim();
                    
                    const parsed = JSON.parse(responseText);

                    if (panel === 'depan') {
                        document.getElementById('depanR').value = parsed.R ?? 0;
                        document.getElementById('depanS').value = parsed.S ?? 0;
                        document.getElementById('depanT').value = parsed.T ?? 0;
                        document.getElementById('depanVolt').value = parsed.Volt ?? 220;
                    } else {
                        document.getElementById('belakangR').value = parsed.R ?? 0;
                        document.getElementById('belakangS').value = parsed.S ?? 0;
                        document.getElementById('belakangT').value = parsed.T ?? 0;
                        document.getElementById('belakangVolt').value = parsed.Volt ?? 220;
                    }

                    calculateTotals();
                    showToast(`Hasil AI Panel ${panel.toUpperCase()} berhasil dibaca!`, "success");
                } else {
                    throw new Error("Format respons AI tidak valid.");
                }
            } catch (err) {
                console.error(err);
                showToast("Gagal membaca gambar dengan AI. Silakan masukkan nilai manual.", "error");
            } finally {
                hideLoading();
            }
        }

        // Init App & Events
        window.onload = function() {
            loadConfig();
            calculateTotals();
            
            const today = new Date().toISOString().split('T')[0];
            const currentMonth = today.substring(0, 7);
            
            document.getElementById('filterDate').value = today;
            document.getElementById('filterMonth').value = currentMonth;
            
            loadLocalHistory();
            fetchDataFromSheets();
        };

        // Tab Switching
        function switchTab(tabName) {
            const secInput = document.getElementById('sectionInput');
            const secHarian = document.getElementById('sectionHarian');
            const secBulanan = document.getElementById('sectionBulanan');

            const btnInput = document.getElementById('tabInputBtn');
            const btnHarian = document.getElementById('tabHarianBtn');
            const btnBulanan = document.getElementById('tabBulananBtn');

            [btnInput, btnHarian, btnBulanan].forEach(btn => {
                btn.className = "flex-1 py-2.5 text-xs font-semibold text-slate-400 hover:text-slate-200 rounded-xl transition flex items-center justify-center gap-2";
            });

            secInput.classList.add('hidden');
            secHarian.classList.add('hidden');
            secBulanan.classList.add('hidden');

            if (tabName === 'input') {
                secInput.classList.remove('hidden');
                btnInput.className = "flex-1 py-2.5 text-xs font-semibold rounded-xl transition flex items-center justify-center gap-2 bg-blue-600 text-white shadow-lg shadow-blue-600/30";
            } else if (tabName === 'harian') {
                secHarian.classList.remove('hidden');
                btnHarian.className = "flex-1 py-2.5 text-xs font-semibold rounded-xl transition flex items-center justify-center gap-2 bg-emerald-600 text-white shadow-lg shadow-emerald-600/30";
                renderHarianView();
            } else if (tabName === 'bulanan') {
                secBulanan.classList.remove('hidden');
                btnBulanan.className = "flex-1 py-2.5 text-xs font-semibold rounded-xl transition flex items-center justify-center gap-2 bg-amber-600 text-white shadow-lg shadow-amber-600/30";
                renderBulananView();
            }
        }

        // Cache Management
        function saveLocalHistory(item) {
            historyLogs.unshift(item);
            localStorage.setItem('meter_history_logs', JSON.stringify(historyLogs));
        }

        function loadLocalHistory() {
            const stored = localStorage.getItem('meter_history_logs');
            if (stored) {
                try { historyLogs = JSON.parse(stored); } catch(e) { historyLogs = []; }
            }
        }

        // Fetch Data from Google Sheets API
        async function fetchDataFromSheets() {
            const appsScriptUrl = localStorage.getItem('meter_appscript_url');
            if (!appsScriptUrl) return;

            try {
                const res = await fetch(appsScriptUrl + "?action=get");
                if (res.ok) {
                    const data = await res.json();
                    if (Array.isArray(data)) {
                        historyLogs = data;
                        localStorage.setItem('meter_history_logs', JSON.stringify(historyLogs));
                        renderHarianView();
                        renderBulananView();
                    }
                }
            } catch(e) {
                // Ignore fetch errors, fallback to local cache
            }
        }

        // Render Views
        function renderHarianView() {
            const selectedDate = document.getElementById('filterDate').value;
            const tbody = document.getElementById('tblHarianBody');
            
            const filtered = historyLogs.filter(log => {
                if (!log.timestamp) return false;
                return log.timestamp.includes(selectedDate) || log.dateKey === selectedDate;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-500 font-sans">Belum ada data pencatatan untuk tanggal ${selectedDate}.</td></tr>`;
                document.getElementById('statHarianCount').innerText = "0";
                document.getElementById('statHarianAvgAmp').innerText = "0.0 A";
                document.getElementById('statHarianPeakAmp').innerText = "0.0 A";
                document.getElementById('statHarianAvgVolt').innerText = "0.0 V";
                return;
            }

            let html = "";
            let sumAvgAmp = 0;
            let sumAvgVolt = 0;
            let peakAmp = 0;

            filtered.forEach(item => {
                const dep = item.depan || {};
                const bel = item.belakang || {};
                const tot = item.total || {};

                const totAvgAmp = tot.Avg || ((dep.Avg || 0) + (bel.Avg || 0));
                const voltAvg = tot.Volt || (((dep.Volt || 0) + (bel.Volt || 0)) / 2);

                sumAvgAmp += totAvgAmp;
                sumAvgVolt += voltAvg;
                if (totAvgAmp > peakAmp) peakAmp = totAvgAmp;

                const timeStr = item.timestamp ? item.timestamp.split(',')[1] || item.timestamp : '-';

                html += `
                    <tr class="hover:bg-slate-800/40 transition">
                        <td class="p-3 font-sans font-medium text-slate-300">${timeStr}</td>
                        <td class="p-3 text-center text-emerald-400">${dep.R || 0}/${dep.S || 0}/${dep.T || 0}</td>
                        <td class="p-3 text-center text-amber-400">${bel.R || 0}/${bel.S || 0}/${bel.T || 0}</td>
                        <td class="p-3 text-center font-bold text-blue-300">${totAvgAmp.toFixed(1)} A</td>
                        <td class="p-3 text-center text-cyan-300">${voltAvg.toFixed(1)} V</td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;
            document.getElementById('statHarianCount').innerText = filtered.length;
            document.getElementById('statHarianAvgAmp').innerText = (sumAvgAmp / filtered.length).toFixed(1) + " A";
            document.getElementById('statHarianPeakAmp').innerText = peakAmp.toFixed(1) + " A";
            document.getElementById('statHarianAvgVolt').innerText = (sumAvgVolt / filtered.length).toFixed(1) + " V";
        }

        function renderBulananView() {
            const selectedMonth = document.getElementById('filterMonth').value;
            const tbody = document.getElementById('tblBulananBody');

            const monthLogs = historyLogs.filter(log => {
                if (!log.timestamp) return false;
                return log.timestamp.includes(selectedMonth) || (log.dateKey && log.dateKey.startsWith(selectedMonth));
            });

            if (monthLogs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-500 font-sans">Belum ada data rekapitulasi untuk bulan ${selectedMonth}.</td></tr>`;
                document.getElementById('statBulanDays').innerText = "0 Hari";
                document.getElementById('statBulanAvgAmp').innerText = "0.0 A";
                document.getElementById('statBulanPeakAmp').innerText = "0.0 A";
                document.getElementById('statBulanVolt').innerText = "0.0 V";
                return;
            }

            const dayGroups = {};
            monthLogs.forEach(item => {
                const dayKey = item.dateKey || (item.timestamp ? item.timestamp.split(',')[0] : 'Unknown');
                if (!dayGroups[dayKey]) dayGroups[dayKey] = [];
                dayGroups[dayKey].push(item);
            });

            let html = "";
            let overallAmpSum = 0;
            let overallVoltSum = 0;
            let monthPeakAmp = 0;
            let daysCount = 0;

            Object.keys(dayGroups).forEach(day => {
                daysCount++;
                const logs = dayGroups[day];
                let dDepAvg = 0, dBelAvg = 0, dTotAvg = 0, dVoltAvg = 0;

                logs.forEach(l => {
                    const dep = l.depan || {};
                    const bel = l.belakang || {};
                    const tot = l.total || {};
                    dDepAvg += dep.Avg || 0;
                    dBelAvg += bel.Avg || 0;
                    const totAmp = tot.Avg || ((dep.Avg || 0) + (bel.Avg || 0));
                    dTotAvg += totAmp;
                    dVoltAvg += tot.Volt || (((dep.Volt || 0) + (bel.Volt || 0)) / 2);

                    if (totAmp > monthPeakAmp) monthPeakAmp = totAmp;
                });

                const count = logs.length;
                const avgDep = dDepAvg / count;
                const avgBel = dBelAvg / count;
                const avgTot = dTotAvg / count;
                const avgVolt = dVoltAvg / count;

                overallAmpSum += avgTot;
                overallVoltSum += avgVolt;

                html += `
                    <tr class="hover:bg-slate-800/40 transition">
                        <td class="p-3 font-sans font-medium text-slate-300">${day}</td>
                        <td class="p-3 text-center text-slate-400">${count}x</td>
                        <td class="p-3 text-center text-emerald-400">${avgDep.toFixed(1)} A</td>
                        <td class="p-3 text-center text-amber-400">${avgBel.toFixed(1)} A</td>
                        <td class="p-3 text-center font-bold text-blue-300">${avgTot.toFixed(1)} A</td>
                        <td class="p-3 text-center text-cyan-300">${avgVolt.toFixed(1)} V</td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;
            document.getElementById('statBulanDays').innerText = daysCount + " Hari";
            document.getElementById('statBulanAvgAmp').innerText = (overallAmpSum / daysCount).toFixed(1) + " A";
            document.getElementById('statBulanPeakAmp').innerText = monthPeakAmp.toFixed(1) + " A";
            document.getElementById('statBulanVolt').innerText = (overallVoltSum / daysCount).toFixed(1) + " V";
        }

        // Save Data to Google Apps Script
        async function saveToSheets() {
            const appsScriptUrl = localStorage.getItem('meter_appscript_url');

            if (!appsScriptUrl) {
                showToast("URL Google Apps Script belum diatur!", "error");
                openConfigModal();
                return;
            }

            showLoading("Menyimpan data ke Google Sheets...");

            const now = new Date();
            const dateISO = now.toISOString().split('T')[0];

            const payload = {
                timestamp: now.toLocaleString('id-ID'),
                dateKey: dateISO,
                depan: {
                    R: parseFloat(document.getElementById('depanR').value) || 0,
                    S: parseFloat(document.getElementById('depanS').value) || 0,
                    T: parseFloat(document.getElementById('depanT').value) || 0,
                    Volt: parseFloat(document.getElementById('depanVolt').value) || 0,
                    Avg: parseFloat(document.getElementById('tblDepanAvg').innerText) || 0
                },
                belakang: {
                    R: parseFloat(document.getElementById('belakangR').value) || 0,
                    S: parseFloat(document.getElementById('belakangS').value) || 0,
                    T: parseFloat(document.getElementById('belakangT').value) || 0,
                    Volt: parseFloat(document.getElementById('belakangVolt').value) || 0,
                    Avg: parseFloat(document.getElementById('tblBelakangAvg').innerText) || 0
                },
                total: {
                    R: parseFloat(document.getElementById('tblTotalR').innerText) || 0,
                    S: parseFloat(document.getElementById('tblTotalS').innerText) || 0,
                    T: parseFloat(document.getElementById('tblTotalT').innerText) || 0,
                    Avg: parseFloat(document.getElementById('tblTotalAvg').innerText) || 0,
                    Volt: parseFloat(document.getElementById('tblTotalVolt').innerText) || 0
                }
            };

            saveLocalHistory(payload);

            try {
                await fetch(appsScriptUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                showToast("Data berhasil dikirim ke Google Sheets!", "success");
            } catch (err) {
                console.error(err);
                showToast("Data tersimpan lokal, gagal koneksi ke Sheets", "error");
            } finally {
                hideLoading();
            }
        }

        // Real-time Calculations
        function calculateTotals() {
            const dR = parseFloat(document.getElementById('depanR').value) || 0;
            const dS = parseFloat(document.getElementById('depanS').value) || 0;
            const dT = parseFloat(document.getElementById('depanT').value) || 0;
            const dVolt = parseFloat(document.getElementById('depanVolt').value) || 0;
            const dAvg = (dR + dS + dT) / 3;

            const bR = parseFloat(document.getElementById('belakangR').value) || 0;
            const bS = parseFloat(document.getElementById('belakangS').value) || 0;
            const bT = parseFloat(document.getElementById('belakangT').value) || 0;
            const bVolt = parseFloat(document.getElementById('belakangVolt').value) || 0;
            const bAvg = (bR + bS + bT) / 3;

            document.getElementById('tblDepanR').innerText = dR.toFixed(1);
            document.getElementById('tblDepanS').innerText = dS.toFixed(1);
            document.getElementById('tblDepanT').innerText = dT.toFixed(1);
            document.getElementById('tblDepanAvg').innerText = dAvg.toFixed(1);
            document.getElementById('tblDepanVolt').innerText = dVolt.toFixed(1);

            document.getElementById('tblBelakangR').innerText = bR.toFixed(1);
            document.getElementById('tblBelakangS').innerText = bS.toFixed(1);
            document.getElementById('tblBelakangT').innerText = bT.toFixed(1);
            document.getElementById('tblBelakangAvg').innerText = bAvg.toFixed(1);
            document.getElementById('tblBelakangVolt').innerText = bVolt.toFixed(1);

            const totR = dR + bR;
            const totS = dS + bS;
            const totT = dT + bT;
            const totAvg = dAvg + bAvg;
            const avgVolt = (dVolt + bVolt) > 0 ? ((dVolt + bVolt) / (dVolt > 0 && bVolt > 0 ? 2 : 1)) : 0;

            document.getElementById('tblTotalR').innerText = totR.toFixed(1);
            document.getElementById('tblTotalS').innerText = totS.toFixed(1);
            document.getElementById('tblTotalT').innerText = totT.toFixed(1);
            document.getElementById('tblTotalAvg').innerText = totAvg.toFixed(1);
            document.getElementById('tblTotalVolt').innerText = avgVolt.toFixed(1);
        }

        // Helpers
        function showLoading(msg) {
            document.getElementById('loadingText').innerText = msg;
            document.getElementById('loadingOverlay').classList.remove('hidden');
        }

        function hideLoading() {
            document.getElementById('loadingOverlay').classList.add('hidden');
        }

        function showToast(msg, type = "info") {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.innerText = msg;

            if (type === 'success') {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-base";
            } else if (type === 'error') {
                toastIcon.className = "fa-solid fa-triangle-exclamation text-rose-400 text-base";
            } else {
                toastIcon.className = "fa-solid fa-circle-info text-blue-400 text-base";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }
    </script>
