<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pencatat Stand Meter Listrik PWA - SMKN 1 Purbalingga</title>
    
    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#0f172a">
    <meta name="description" content="Aplikasi Pencatat Stand Meter Listrik Panel Depan dan Belakang dengan AI OCR Vision & Google Sheets Backend">
    <link rel="manifest" href="data:application/manifest+json,{
        &quot;name&quot;: &quot;Stand Meter PWA - SMKN 1 Purbalingga&quot;,
        &quot;short_name&quot;: &quot;StandMeter&quot;,
        &quot;start_url&quot;: &quot;.&quot;,
        &quot;display&quot;: &quot;standalone&quot;,
        &quot;background_color&quot;: &quot;#0f172a&quot;,
        &quot;theme_color&quot;: &quot;#0f172a&quot;,
        &quot;icons&quot;: [{
            &quot;src&quot;: &quot;https://cdn-icons-png.flaticon.com/512/2983/2983780.png&quot;,
            &quot;sizes&quot;: &quot;192x192&quot;,
            &quot;type&quot;: &quot;image/png&quot;
        }]
    }">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #0b0f19;
            color: #f8fafc;
        }
        .panel-card {
            background: rgba(30, 41, 59, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-modal {
            background: rgba(15, 23, 42, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }
        /* Custom Loading Spinner */
        .spinner {
            border: 4px solid rgba(255, 255, 255, 0.1);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border-left-color: #3b82f6;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
    </style>
</head>
<body class="min-h-screen pb-12 flex flex-col justify-between">

    <div>
        <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 p-4 sticky top-0 z-40 shadow-xl">
            <div class="max-w-5xl mx-auto flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 bg-gradient-to-tr from-blue-600 to-cyan-500 text-white rounded-xl shadow-lg shadow-blue-500/20">
                        <i class="fa-solid fa-bolt text-xl"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-base sm:text-lg leading-tight text-slate-100">SMK Negeri 1 Purbalingga</h1>
                        <p class="text-[11px] sm:text-xs text-slate-400">Monitoring Stand Meter Listrik 3 Fase (Panel Depan & Belakang)</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="openScriptGuideModal()" class="p-2 sm:px-3 sm:py-2 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-400 border border-emerald-500/30 rounded-lg transition text-xs font-semibold flex items-center gap-1.5">
                        <i class="fa-solid fa-database"></i>
                        <span class="hidden sm:inline">Setup GAS Database</span>
                    </button>
                    <button onclick="openConfigModal()" class="p-2 sm:px-3 sm:py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-lg transition text-xs font-semibold flex items-center gap-1.5">
                        <i class="fa-solid fa-gear"></i>
                        <span class="hidden sm:inline">Pengaturan</span>
                    </button>
                </div>
            </div>
        </header>

        <div class="max-w-5xl mx-auto px-4 pt-4">
            <div class="flex bg-slate-900/90 p-1.5 rounded-2xl border border-slate-800/80 shadow-inner">
                <button id="tabInputBtn" onclick="switchTab('input')" class="flex-1 py-2.5 text-xs font-semibold rounded-xl transition flex items-center justify-center gap-2 bg-blue-600 text-white shadow-lg shadow-blue-600/30">
                    <i class="fa-solid fa-pen-to-square"></i> Input Stand Meter
                </button>
                <button id="tabHarianBtn" onclick="switchTab('harian')" class="flex-1 py-2.5 text-xs font-semibold text-slate-400 hover:text-slate-200 rounded-xl transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-calendar-day"></i> Rekap Harian
                </button>
                <button id="tabBulananBtn" onclick="switchTab('bulanan')" class="flex-1 py-2.5 text-xs font-semibold text-slate-400 hover:text-slate-200 rounded-xl transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-chart-column"></i> Rekap Bulanan
                </button>
            </div>
        </div>

        <main class="max-w-5xl mx-auto p-4 space-y-6">

            <div id="apiAlert" class="bg-amber-500/10 border border-amber-500/30 text-amber-300 p-3.5 rounded-2xl text-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 shadow-lg">
                <div class="flex items-center gap-2.5">
                    <i class="fa-solid fa-triangle-exclamation text-amber-400 text-lg shrink-0"></i>
                    <span>Database Google Apps Script belum terhubung. Konfigurasikan URL Web App terlebih dahulu.</span>
                </div>
                <div class="flex items-center gap-2 self-end sm:self-auto">
                    <button onclick="openScriptGuideModal()" class="bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 px-2.5 py-1 rounded-lg border border-amber-500/40 font-semibold text-[11px] transition">Ambil Kode GAS</button>
                    <button onclick="openConfigModal()" class="bg-amber-500 text-slate-950 font-semibold px-2.5 py-1 rounded-lg text-[11px] transition">Atur URL</button>
                </div>
            </div>

            <div id="sectionInput" class="space-y-6">
                <!-- Dual Meter Panels Grid -->
                <div class="grid md:grid-cols-2 gap-6">
                    
                    <!-- PANEL DEPAN -->
                    <div class="panel-card p-5 rounded-2xl space-y-4 shadow-xl">
                        <div class="flex justify-between items-center border-b border-slate-700/60 pb-3">
                            <h2 class="font-bold text-base sm:text-lg text-emerald-400 flex items-center gap-2">
                                <i class="fa-solid fa-solar-panel"></i> Panel Meter Depan
                            </h2>
                            <span class="text-[11px] bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-2.5 py-0.5 rounded-full font-medium">Meter 1</span>
                        </div>

                        <!-- Image Capture Box -->
                        <div class="relative w-full h-44 bg-slate-950/80 rounded-xl overflow-hidden border border-dashed border-slate-700/80 flex flex-col justify-center items-center group">
                            <img id="imgDepanPreview" class="hidden w-full h-full object-cover">
                            <div id="placeholderDepan" class="text-center p-4">
                                <i class="fa-solid fa-camera text-3xl text-slate-600 mb-2 group-hover:text-slate-400 transition"></i>
                                <p class="text-xs text-slate-400">Klik untuk mengambil foto panel meter depan</p>
                            </div>
                            <input type="file" id="fileDepan" accept="image/*" capture="environment" class="hidden" onchange="handleImageUpload(event, 'depan')">
                            <button onclick="document.getElementById('fileDepan').click()" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"></button>
                        </div>

                        <div class="flex gap-2">
                            <button onclick="document.getElementById('fileDepan').click()" class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs py-2 px-3 rounded-lg flex justify-center items-center gap-2 border border-slate-700 transition">
                                <i class="fa-solid fa-camera"></i> Foto Meter
                            </button>
                            <button onclick="processAI('depan')" id="btnAnalyzeDepan" class="flex-1 bg-blue-600 hover:bg-blue-500 text-white text-xs py-2 px-3 rounded-lg flex justify-center items-center gap-2 transition shadow-md shadow-blue-600/20 disabled:opacity-50">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Baca AI OCR
                            </button>
                        </div>

                        <!-- Manual Numeric Inputs -->
                        <div class="grid grid-cols-2 gap-3 pt-1">
                            <div>
                                <label class="text-[11px] text-slate-400 block mb-1">Ampere R (A)</label>
                                <input type="number" step="0.1" id="depanR" placeholder="0.0" oninput="calculateTotals()" class="w-full bg-slate-950/80 border border-slate-800 rounded-lg p-2.5 text-sm text-center font-mono focus:border-blue-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[11px] text-slate-400 block mb-1">Ampere S (A)</label>
                                <input type="number" step="0.1" id="depanS" placeholder="0.0" oninput="calculateTotals()" class="w-full bg-slate-950/80 border border-slate-800 rounded-lg p-2.5 text-sm text-center font-mono focus:border-blue-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[11px] text-slate-400 block mb-1">Ampere T (A)</label>
                                <input type="number" step="0.1" id="depanT" placeholder="0.0" oninput="calculateTotals()" class="w-full bg-slate-950/80 border border-slate-800 rounded-lg p-2.5 text-sm text-center font-mono focus:border-blue-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[11px] text-slate-400 block mb-1">Voltase (V)</label>
                                <input type="number" step="0.1" id="depanVolt" placeholder="220" oninput="calculateTotals()" class="w-full bg-slate-950/80 border border-slate-800 rounded-lg p-2.5 text-sm text-center font-mono focus:border-blue-500 focus:outline-none">
                            </div>
                        </div>
                    </div>

                    <!-- PANEL BELAKANG -->
                    <div class="panel-card p-5 rounded-2xl space-y-4 shadow-xl">
                        <div class="flex justify-between items-center border-b border-slate-700/60 pb-3">
                            <h2 class="font-bold text-base sm:text-lg text-amber-400 flex items-center gap-2">
                                <i class="fa-solid fa-solar-panel"></i> Panel Meter Belakang
                            </h2>
                            <span class="text-[11px] bg-amber-500/10 border border-amber-500/30 text-amber-400 px-2.5 py-0.5 rounded-full font-medium">Meter 2</span>
                        </div>

                        <!-- Image Capture Box -->
                        <div class="relative w-full h-44 bg-slate-950/80 rounded-xl overflow-hidden border border-dashed border-slate-700/80 flex flex-col justify-center items-center group">
                            <img id="imgBelakangPreview" class="hidden w-full h-full object-cover">
                            <div id="placeholderBelakang" class="text-center p-4">
                                <i class="fa-solid fa-camera text-3xl text-slate-600 mb-2 group-hover:text-slate-400 transition"></i>
                                <p class="text-xs text-slate-400">Klik untuk mengambil foto panel meter belakang</p>
                            </div>
                            <input type="file" id="fileBelakang" accept="image/*" capture="environment" class="hidden" onchange="handleImageUpload(event, 'belakang')">
                            <button onclick="document.getElementById('fileBelakang').click()" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"></button>
                        </div>

                        <div class="flex gap-2">
                            <button onclick="document.getElementById('fileBelakang').click()" class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs py-2 px-3 rounded-lg flex justify-center items-center gap-2 border border-slate-700 transition">
                                <i class="fa-solid fa-camera"></i> Foto Meter
                            </button>
                            <button onclick="processAI('belakang')" id="btnAnalyzeBelakang" class="flex-1 bg-blue-600 hover:bg-blue-500 text-white text-xs py-2 px-3 rounded-lg flex justify-center items-center gap-2 transition shadow-md shadow-blue-600/20 disabled:opacity-50">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Baca AI OCR
                            </button>
                        </div>

                        <!-- Manual Numeric Inputs -->
                        <div class="grid grid-cols-2 gap-3 pt-1">
                            <div>
                                <label class="text-[11px] text-slate-400 block mb-1">Ampere R (A)</label>
                                <input type="number" step="0.1" id="belakangR" placeholder="0.0" oninput="calculateTotals()" class="w-full bg-slate-950/80 border border-slate-800 rounded-lg p-2.5 text-sm text-center font-mono focus:border-blue-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[11px] text-slate-400 block mb-1">Ampere S (A)</label>
                                <input type="number" step="0.1" id="belakangS" placeholder="0.0" oninput="calculateTotals()" class="w-full bg-slate-950/80 border border-slate-800 rounded-lg p-2.5 text-sm text-center font-mono focus:border-blue-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[11px] text-slate-400 block mb-1">Ampere T (A)</label>
                                <input type="number" step="0.1" id="belakangT" placeholder="0.0" oninput="calculateTotals()" class="w-full bg-slate-950/80 border border-slate-800 rounded-lg p-2.5 text-sm text-center font-mono focus:border-blue-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[11px] text-slate-400 block mb-1">Voltase (V)</label>
                                <input type="number" step="0.1" id="belakangVolt" placeholder="220" oninput="calculateTotals()" class="w-full bg-slate-950/80 border border-slate-800 rounded-lg p-2.5 text-sm text-center font-mono focus:border-blue-500 focus:outline-none">
                            </div>
                        </div>
                    </div>

                </div>

                <div class="panel-card p-5 rounded-2xl space-y-4 shadow-xl">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-slate-700/60 pb-3">
                        <h2 class="font-bold text-base sm:text-lg text-blue-400 flex items-center gap-2">
                            <i class="fa-solid fa-table-list"></i> Kalkulasi & Ringkasan Hasil
                        </h2>
                        <button onclick="saveToSheets()" id="btnSaveSheets" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs px-5 py-2.5 rounded-xl flex items-center justify-center gap-2 transition shadow-lg shadow-emerald-900/40">
                            <i class="fa-solid fa-cloud-arrow-up text-sm"></i> Simpan Ke Database Google Sheets
                        </button>
                    </div>

                    <div class="overflow-x-auto rounded-xl border border-slate-800">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-slate-900/90 text-slate-400 text-xs uppercase tracking-wider border-b border-slate-800">
                                <tr>
                                    <th class="p-3">Kategori Panel</th>
                                    <th class="p-3 text-center">R (Ampere)</th>
                                    <th class="p-3 text-center">S (Ampere)</th>
                                    <th class="p-3 text-center">T (Ampere)</th>
                                    <th class="p-3 text-center">Rata-rata Ampere</th>
                                    <th class="p-3 text-center">Voltase (V)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800/60 font-mono text-slate-200">
                                <tr>
                                    <td class="p-3 font-sans font-semibold text-emerald-400">Meter Depan</td>
                                    <td id="tblDepanR" class="p-3 text-center">0.0</td>
                                    <td id="tblDepanS" class="p-3 text-center">0.0</td>
                                    <td id="tblDepanT" class="p-3 text-center">0.0</td>
                                    <td id="tblDepanAvg" class="p-3 text-center font-bold text-slate-300">0.0</td>
                                    <td id="tblDepanVolt" class="p-3 text-center">0.0</td>
                                </tr>
                                <tr>
                                    <td class="p-3 font-sans font-semibold text-amber-400">Meter Belakang</td>
                                    <td id="tblBelakangR" class="p-3 text-center">0.0</td>
                                    <td id="tblBelakangS" class="p-3 text-center">0.0</td>
                                    <td id="tblBelakangT" class="p-3 text-center">0.0</td>
                                    <td id="tblBelakangAvg" class="p-3 text-center font-bold text-slate-300">0.0</td>
                                    <td id="tblBelakangVolt" class="p-3 text-center">0.0</td>
                                </tr>
                                <tr class="bg-blue-950/40 font-bold border-t-2 border-slate-700">
                                    <td class="p-3 font-sans text-blue-300">TOTAL / RATA2</td>
                                    <td id="tblTotalR" class="p-3 text-center text-blue-300">0.0</td>
                                    <td id="tblTotalS" class="p-3 text-center text-blue-300">0.0</td>
                                    <td id="tblTotalT" class="p-3 text-center text-blue-300">0.0</td>
                                    <td id="tblTotalAvg" class="p-3 text-center text-emerald-300">0.0</td>
                                    <td id="tblTotalVolt" class="p-3 text-center text-blue-300">0.0</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div id="sectionHarian" class="space-y-6 hidden">
                <div class="panel-card p-5 rounded-2xl space-y-4 shadow-xl">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-700/60 pb-3">
                        <div>
                            <h2 class="font-bold text-base sm:text-lg text-emerald-400 flex items-center gap-2">
                                <i class="fa-solid fa-calendar-day"></i> Rekap Pencatatan Harian
                            </h2>
                            <p class="text-xs text-slate-400">Riwayat pengamatan beban listrik per hari</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="date" id="filterDate" onchange="renderHarianView()" class="bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none">
                            <button onclick="fetchDataFromSheets()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 p-2 text-xs rounded-lg border border-slate-700 transition flex items-center gap-1.5">
                                <i class="fa-solid fa-rotate"></i> Sync
                            </button>
                        </div>
                    </div>

                    <!-- Daily Summary Stats -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800">
                            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Total Entry Hari Ini</span>
                            <span id="statHarianCount" class="text-xl font-bold text-blue-400 font-mono mt-1 block">0</span>
                        </div>
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800">
                            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Rata-rata Ampere</span>
                            <span id="statHarianAvgAmp" class="text-xl font-bold text-emerald-400 font-mono mt-1 block">0.0 A</span>
                        </div>
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800">
                            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Peak Ampere</span>
                            <span id="statHarianPeakAmp" class="text-xl font-bold text-amber-400 font-mono mt-1 block">0.0 A</span>
                        </div>
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800">
                            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Rata-rata Voltase</span>
                            <span id="statHarianAvgVolt" class="text-xl font-bold text-cyan-400 font-mono mt-1 block">0.0 V</span>
                        </div>
                    </div>

                    <div class="overflow-x-auto rounded-xl border border-slate-800">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-900/90 text-slate-400 uppercase tracking-wider border-b border-slate-800">
                                <tr>
                                    <th class="p-3">Waktu</th>
                                    <th class="p-3 text-center">Depan (R/S/T)</th>
                                    <th class="p-3 text-center">Belakang (R/S/T)</th>
                                    <th class="p-3 text-center">Total Avg Ampere</th>
                                    <th class="p-3 text-center">Voltase Avg</th>
                                </tr>
                            </thead>
                            <tbody id="tblHarianBody" class="divide-y divide-slate-800/60 font-mono text-slate-200">
                                <tr>
                                    <td colspan="5" class="p-4 text-center text-slate-500 font-sans">Belum ada data pencatatan untuk tanggal ini.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div id="sectionBulanan" class="space-y-6 hidden">
                <div class="panel-card p-5 rounded-2xl space-y-4 shadow-xl">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-700/60 pb-3">
                        <div>
                            <h2 class="font-bold text-base sm:text-lg text-amber-400 flex items-center gap-2">
                                <i class="fa-solid fa-chart-column"></i> Rekapitulasi Bulanan
                            </h2>
                            <p class="text-xs text-slate-400">Analisis tren dan rata-rata harian dalam satu bulan</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="month" id="filterMonth" onchange="renderBulananView()" class="bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none">
                            <button onclick="fetchDataFromSheets()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 p-2 text-xs rounded-lg border border-slate-700 transition flex items-center gap-1.5">
                                <i class="fa-solid fa-rotate"></i> Sync
                            </button>
                        </div>
                    </div>

                    <!-- Monthly Stats -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800">
                            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Total Hari Tercatat</span>
                            <span id="statBulanDays" class="text-xl font-bold text-blue-400 font-mono mt-1 block">0 Hari</span>
                        </div>
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800">
                            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Rata-rata Ampere</span>
                            <span id="statBulanAvgAmp" class="text-xl font-bold text-emerald-400 font-mono mt-1 block">0.0 A</span>
                        </div>
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800">
                            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Beban Peak Bulan Ini</span>
                            <span id="statBulanPeakAmp" class="text-xl font-bold text-rose-400 font-mono mt-1 block">0.0 A</span>
